// Rolls highlights off instead of clipping them, so bright light keeps its surface detail. Below the start it changes nothing.
const float SHOULDER_START = 0.75;
vec3 shoulder(vec3 c) {
	vec3 rolled = SHOULDER_START + (1.0 - SHOULDER_START) * (1.0 - exp((SHOULDER_START - c) / (1.0 - SHOULDER_START)));
	return mix(c, rolled, step(vec3(SHOULDER_START), c));
}

const float ACCUMULATION_TRUST = 16.0; // Frames at which an accumulating pixel is half unfiltered.
const float ACCUMULATION_DEPTH_CHANGE = 0.01; // Blocks of distance, enough to tell a placed or broken block from rounding.
const int ITERATION_ASSEMBLE = 1; // Ray Reconstruction's noisy input, at the render size.
const int ITERATION_FINISH = 2; // After Ray Reconstruction, at full size.
const int ITERATION_UPSCALE_INPUT = 3; // The finished image at the render size, for Super Resolution.
const int ITERATION_UPSCALE_FINISH = 4; // After Super Resolution, at full size.
const int ITERATION_HAND = 5; // After the first person hand draws, for Frame Generation, at the render size.
// Light shafts are traced and filtered at half the render size: half-size pixel i belongs to render pixel 2i. A point on the render image, in
// render pixels, blends the four nearest, favouring those as far from the camera as its own surface, so shafts and underwater haze don't bleed
// across silhouettes.
const float SCATTER_SKY_DISTANCE = 4096.0;
vec3 scatteredAt(vec2 renderPosition) {
	ivec2 size = imageSize(volumetricFiltered), fullSize = imageSize(gCurrent);
	float own = imageLoad(gCurrent, clamp(ivec2(renderPosition), ivec2(0), fullSize - 1)).w;
	own = own <= 0.0 ? SCATTER_SKY_DISTANCE : own;
	vec2 texel = (renderPosition - 0.5) * 0.5;
	ivec2 base = ivec2(floor(texel));
	vec2 f = texel - vec2(base);
	vec3 sum = vec3(0.0);
	float total = 0.0;
	for (int i = 0; i < 4; i++) {
		ivec2 q = clamp(base + ivec2(i & 1, i >> 1), ivec2(0), size - 1);
		float distance_ = imageLoad(gCurrent, min(q * 2, fullSize - 1)).w;
		distance_ = distance_ <= 0.0 ? SCATTER_SKY_DISTANCE : distance_;
		float weight = ((i & 1) != 0 ? f.x : 1.0 - f.x) * ((i >> 1) != 0 ? f.y : 1.0 - f.y) / (0.05 + abs(distance_ - own) / own) + 1.0e-5;
		sum += imageLoad(volumetricFiltered, q).rgb * weight;
		total += weight;
	}
	return sum / total;
}

// DLSS keeps one bad pixel in its history and spreads it over a whole tile, so nothing that isn't a finite, non-negative colour reaches it.
vec3 dlssSafe(vec3 c) {
	// The images are half floats, so anything brighter than this would turn into infinity there.
	return any(isnan(c)) || any(isinf(c)) ? vec3(0.0) : clamp(c, vec3(0.0), vec3(32768.0));
}

void storeDlssInput(ivec2 p, vec3 c) {
	imageStore(rayReconstructionInput, p, vec4(dlssSafe(c), 1.0));
}

// Ray Reconstruction blends terrain into the sky pixels beside it, and those pixels get no mist of their own. Next to misted terrain they take the sky directly.
const int FOG_SKY_EDGE_RADIUS = 2;
vec3 clearFoggedSkyEdge(ivec2 p, vec3 clean) {
	if ((pc.flags & 262144) == 0) return clean;
	float amount = 0.0;
	for (int y = -FOG_SKY_EDGE_RADIUS; y <= FOG_SKY_EDGE_RADIUS; y += FOG_SKY_EDGE_RADIUS) {
		for (int x = -FOG_SKY_EDGE_RADIUS; x <= FOG_SKY_EDGE_RADIUS; x += FOG_SKY_EDGE_RADIUS) {
			ivec2 q = clamp(p + ivec2(x, y), ivec2(0), rasterSize() - 1);
			float depth = texelFetch(depthTex, q, 0).r;
			if (depth <= 0.0) continue;
			vec3 seenAt = unprojectUv(rasterUv(q), depth);
			amount = max(amount, fogAmount(normalize(seenAt), length(seenAt)));
		}
	}
	return amount > 0.0 ? mix(clean, skyView(normalize(unprojectUv(rasterUv(p), 0.0001)), true), amount) : clean;
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	loadUpscale();
	if (pc.iteration == ITERATION_HAND) {
		// Vanilla clears depth to 0 before the hand, so anything nearer is the hand. It moves with the camera, so it gets no motion,
		// and its own depth, or Frame Generation drags it along with the world behind it.
		if (any(greaterThanEqual(p, imageSize(screenMotionImage)))) return;
		float hand = texelFetch(depthTex, rasterPixel(p), 0).r;
		if (hand > 0.0) {
			imageStore(screenMotionImage, p, vec4(0.0));
			imageStore(renderDepthImage, p, vec4(hand));
		}
		return;
	}
	if (pc.iteration == ITERATION_FINISH || pc.iteration == ITERATION_UPSCALE_FINISH) {
		if (any(greaterThanEqual(p, rasterSize()))) return;
		float alpha = texelFetch(colorTex, p, 0).a;
		vec3 clean = imageLoad(rayReconstructionOutput, p).rgb;
		if (pc.iteration == ITERATION_UPSCALE_FINISH) {
			imageStore(outImage, p, vec4(clean, alpha));
			return;
		}
		vec3 scattered = (pc.flags & 4) != 0 ? scatteredAt((vec2(p) + 0.5) / upscaleRatio) : vec3(0.0);
		float rasterDepth = texelFetch(depthTex, p, 0).r;
		bool skyPixel = rasterDepth <= 0.0;
		vec3 waterSigma;
		// Under water the sky is replaced by the water's own haze, which is lit like everything else.
		if (skyPixel && cameraUnderwater(waterSigma)) imageStore(outImage, p, vec4(shoulder(scattered * exposure()), alpha));
		else {
			// Mist goes on after Ray Reconstruction, which would otherwise have to denoise through it.
			if (!skyPixel) {
				vec3 seenAt = unprojectUv(rasterUv(p), rasterDepth);
				clean = applyFog(clean, normalize(seenAt), length(seenAt));
				clean += scattered;
			} else {
				vec3 skyDir = normalize(unprojectUv(rasterUv(p), 0.0001));
				clean = skyWithShafts(applySkyMist(clearFoggedSkyEdge(p, clean), skyDir), scattered, skyDir);
			}
			imageStore(outImage, p, vec4(shoulder(clean * exposure()), alpha));
		}
		return;
	}
	if (any(greaterThanEqual(p, imageSize(albedoImage)))) return;
	vec4 color = texelFetch(colorTex, rasterPixel(p), 0);
	vec3 scattered = (pc.flags & 4) != 0 ? scatteredAt(vec2(p) + 0.5) : vec3(0.0);
	bool sky = imageLoad(gCurrent, p).w <= 0.0;
	bool assemble = pc.iteration == ITERATION_ASSEMBLE;
	if (assemble) {
		// Distance along the view direction: the clip w that inverse projection divides away. The sky is far.
		float depth = imageLoad(renderDepthImage, p).r;
		vec4 h = pc.invViewProj * vec4(rasterUv(rasterPixel(p)) * 2.0 - 1.0, max(depth, 1.0e-7), 1.0);
		imageStore(linearDepthImage, p, vec4(depth <= 0.0 ? 65504.0 : min(1.0 / abs(h.w), 65504.0)));
	}
	bool upscaleInput = pc.iteration == ITERATION_UPSCALE_INPUT;
	vec3 waterSigma;
	bool underwater = cameraUnderwater(waterSigma);
	// Light from what the camera sees fades through the water in between.
	vec3 waterKept = underwater ? exp(-waterSigma * imageLoad(gCurrent, p).w) : vec3(1.0);
	if (sky && underwater) {
		if (assemble) {
			storeDlssInput(p, vec3(0.0));
			imageStore(diffuseGuideImage, p, vec4(1.0));
		} else {
			meterExposure(p, scattered);
			vec3 haze = shoulder(scattered * exposure());
			if (upscaleInput) storeDlssInput(p, haze);
			else imageStore(outImage, p, vec4(haze, color.a));
		}
		return;
	}
	if (sky) {
		// The physical sky replaces vanilla's, lit and exposed like everything else.
		vec3 skyDir = normalize(unprojectUv(rasterUv(rasterPixel(p)), 0.0001));
		vec3 seen = skyView(skyDir, true);
		// With Ray Reconstruction the mist goes on in the finish pass.
		if (!assemble) seen = applySkyMist(seen, skyDir);
		if (assemble || upscaleInput || pc.iteration == 0) meterExposure(p, skyWithShafts(seen, scattered, skyDir));
		if (assemble) {
			storeDlssInput(p, seen);
			imageStore(diffuseGuideImage, p, vec4(1.0));
		} else {
			vec3 finished = shoulder(skyWithShafts(seen, scattered, skyDir) * exposure());
			if (upscaleInput) storeDlssInput(p, finished);
			else imageStore(outImage, p, vec4(finished, color.a));
		}
		return;
	}
	vec4 surface = imageLoad(albedoImage, p);
	// An amount above 1 marks a clean specular result, such as enhanced water, stored in place of the albedo. It skips the denoised copy.
	bool clean = surface.a > 1.0;
	vec3 cleanLight = surface.rgb;
	if (clean) surface = vec4(0.0, 0.0, 0.0, surface.a - 1.0);
	color.rgb *= imageLoad(parallaxImage, p).rgb;
	// Vanilla's lightmap is white while tracing, so color is the unlit surface and all light comes from here.
	// Normal map and occlusion detail skips the denoiser, so it stays sharp.
	vec4 detail = imageLoad(detailImage, p);
	vec3 lighting = (assemble ? imageLoad(shadowNoisy, p).rgb : imageLoad(shadowFiltered, p).rgb) * detail.x;
	if ((pc.flags & 1) != 0) {
		vec3 gi = assemble ? imageLoad(giNoisy, p).rgb : imageLoad(giFiltered, p).rgb;
		lighting += gi;
		// On clean water, detail holds how much of the GI at its surface shows through it.
		if (clean) cleanLight += detail.rgb * gi;
	}
	vec3 lit = color.rgb * lighting * detail.y + surface.rgb * detail.w;
	vec3 viewDir = normalize(unprojectUv(rasterUv(rasterPixel(p)), 0.0001));
	float viewDistance = imageLoad(gCurrent, p).w;
	if (((p.x | p.y) & 7) == 0) meterExposure(p, applyFog(mix(lit, clean ? cleanLight : imageLoad(reflectionNoisy, p).rgb, surface.a) * waterKept, viewDir, viewDistance) + scattered);
	if (assemble) {
		storeDlssInput(p, mix(lit, clean ? cleanLight : imageLoad(reflectionNoisy, p).rgb, surface.a) * waterKept);
		imageStore(diffuseGuideImage, p, vec4(dlssSafe(clean ? detail.rgb : vec3(color.rgb * (1.0 - surface.a))), 1.0));
		return;
	}
	vec3 light = mix(lit, clean ? cleanLight : imageLoad(reflectionFiltered, p).rgb, surface.a) * waterKept;
	// A still view in Path Tracing converges on the unfiltered paths. The denoised image covers the first frames, and fades as samples add up.
	if (pc.iteration == 0 && (pc.flags & 65536) != 0 && !clean) {
		vec3 rawLighting = imageLoad(shadowNoisy, p).rgb * detail.x + imageLoad(giNoisy, p).rgb;
		vec3 raw = dlssSafe(mix(color.rgb * rawLighting * detail.y + surface.rgb * detail.w, imageLoad(reflectionNoisy, p).rgb, surface.a) * waterKept);
		vec4 mean = imageLoad(accumulationImage, p);
		vec4 motion = imageLoad(motionImage, p);
		// Anything moving or changing under this pixel starts over on its own, without restarting the rest of the view.
		float samples = (pc.flags & 131072) != 0 || motion.w < 0.0 || dot(motion.xyz, motion.xyz) > 1.0e-6 || abs(imageLoad(gCurrent, p).w - imageLoad(gPrevious, p).w) > ACCUMULATION_DEPTH_CHANGE ? 0.0 : mean.a;
		samples = min(samples + 1.0, Lights(pc.lights).l[PARAMS_PATH].w);
		mean.rgb = mix(mean.rgb, raw, 1.0 / samples);
		imageStore(accumulationImage, p, vec4(mean.rgb, samples));
		light = mix(light, mean.rgb, (pc.flags & 32) != 0 ? 1.0 : samples / (samples + ACCUMULATION_TRUST));
	}
	vec3 finished = shoulder((applyFog(light, viewDir, viewDistance) + scattered) * exposure());
	if (upscaleInput) storeDlssInput(p, finished);
	else imageStore(outImage, p, vec4(finished, color.a));
}
